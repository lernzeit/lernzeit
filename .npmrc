# @prerenderer/rollup-plugin erklaert rollup ^3||^4 als peer, vite-plugin-pwa
# (workbox-build) bringt rollup 2 mit. Der Build nutzt Vites eigenes Rollup und
# laeuft; ohne diese Zeile bricht aber `npm ci`/`npm install` mit ERESOLVE ab –
# also auch der iOS-Build in Codemagic und der Android-Ablauf (05.10.2026).
legacy-peer-deps=true
